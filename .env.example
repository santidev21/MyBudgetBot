# MyBudget-bot - environment template
#
# Copy this file to '.env' and replace every CHANGE_ME value.
# '.env' must NEVER be committed to git.
#
# Generate secrets:
#   openssl rand -hex 32

# === Telegram ================================================================
# Token issued by @BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME_123456789:AAExampleBotTokenIssuedByBotFather

# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Random, 32+ characters, no quotes or whitespace.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_CHARS_MINIMUM

# Random path segment used to make the webhook URL unguessable.
# Example value below is what a real one looks like.
TELEGRAM_WEBHOOK_PATH=CHANGE_ME_RANDOM_PATH_SEGMENT_32_CHARS

# Telegram user ids allowed to use the bot (comma separated, no spaces).
# This bot is private: unknown users are refused. Get yours from @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Public HTTPS base URL. Only used to register the webhook; the secret path segment is
# appended by the application. Required when using webhooks, not needed with polling.
TELEGRAM_PUBLIC_BASE_URL=https://mybudget.santidev21.tech

# Long polling instead of webhooks. Local development only: Telegram allows one transport
# at a time, and polling needs no public URL.
TELEGRAM_USE_POLLING=false

# How long the bot waits before treating a Telegram update as stale (minutes).
# After long downtime Telegram replays queued updates; stale ones are ignored.
TELEGRAM_STALE_UPDATE_MINUTES=15

# How long a started conversation stays resumable before it is cleared (minutes).
TELEGRAM_CONVERSATION_TIMEOUT_MINUTES=30

# === Localization ============================================================
DEFAULT_LANGUAGE=es
DEFAULT_TIME_ZONE=America/Bogota

# === Database ================================================================
POSTGRES_DB=mybudget

# Superuser of the PostgreSQL instance. Used only to create the database and
# the two least-privilege roles below. Never used by the application.
POSTGRES_USER=mybudget_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD

# Runtime application role: SELECT/INSERT/UPDATE/DELETE only, no DDL.
DB_APP_USER=mybudget_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Migration role: owns the schema and may run DDL. Used only by the one-shot
# migrator container.
DB_MIGRATOR_USER=mybudget_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_PASSWORD

# Local development only (host machine, not Docker).
# This MUST use the migrator role: 'dotnet ef database update' needs DDL, and the runtime
# role intentionally has none (it would fail with "permission denied for schema public").
# Port 5435 matches docker-compose.local.yml: 5432 is the Postgres default every tool grabs,
# and other projects on this host already use 5433 and 5434.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5435;Database=mybudget;Username=mybudget_migrator;Password=CHANGE_ME_STRONG_MIGRATOR_PASSWORD

# === Operations ==============================================================
# Telegram user id that receives operational alerts (backup failures, crashes).
ADMIN_TELEGRAM_USER_ID=123456789

# Backup retention (see docs/BACKUPS.md).
BACKUP_RETENTION_DAYS=7
